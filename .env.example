# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From the Tiger Data console. Should end in ?sslmode=require
DATABASE_URL=

# From https://aistudio.google.com. If it's missing, goals still work, but partners only see the goal type.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional. Database connections per server. Keep this low on a free plan.
DB_POOL_MAX=3
