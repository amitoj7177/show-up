# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From the Tiger Data console. Should end in ?sslmode=require
DATABASE_URL=

# From https://aistudio.google.com. If it's missing, goals still work, but partners only see the goal type.
GEMINI_API_KEY=

# From your Auth0 application's settings page. Turn on the "Password" grant type there too.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Optional: Fitbit through Google's Health API. From Google Cloud → Credentials → OAuth client (Web application).
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# A private key for the Fitbit access list at /admin. Make up any long password.
ADMIN_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional. Database connections per server. Keep this low on a free plan.
DB_POOL_MAX=3
